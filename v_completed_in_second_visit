CREATE VIEW glue_database_bi_bluecollar.v_completed_in_second_visit AS
SELECT
  job_id
, min(date_parse(upper("event_date_times"), '%m/%d/%Y %h:%i %p')) job_start_date
, max(date_parse(upper("event_date_times"), '%m/%d/%Y %h:%i %p')) job_end_date
, date_diff('day', min(date_parse(upper("event_date_times"), '%m/%d/%Y %h:%i %p')), max(date_parse(upper("event_date_times"), '%m/%d/%Y %h:%i %p'))) days_for_job
FROM
  v_individual_tech_report
GROUP BY job_id
HAVING ((count(DISTINCT date(date_parse(upper("event_date_times"), '%m/%d/%Y %h:%i %p'))) = 2) AND (date_diff('day', min(date_parse(upper("event_date_times"), '%m/%d/%Y %h:%i %p')), max(date_parse(upper("event_date_times"), '%m/%d/%Y %h:%i %p'))) < 90))
ORDER BY days_for_job DESC

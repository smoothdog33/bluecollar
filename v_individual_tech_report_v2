CREATE VIEW glue_database_bi_bluecollar.v_individual_tech_report_v2 AS
SELECT
  substring(COALESCE(individual_tech_report.job_id, jobnumber, jobstartdate), 8, 10) job_id
, substring(event_date_time, 14, 19) event_date_times
, substring(event_status, 7, 25) event_status
, first_tech
FROM
  (individual_tech_report
LEFT JOIN (
   SELECT DISTINCT
     JOB_ID
   , FIRST_TECH
   FROM
     v_clean_job_activity
)  v_clean_job_activity ON (substring(COALESCE(individual_tech_report.job_id, jobnumber, jobstartdate), 8, 10) = v_clean_job_activity.job_id))
WHERE ((individual_tech_report.job_id IS NOT NULL) AND (event_status LIKE 'EVENT:%'))

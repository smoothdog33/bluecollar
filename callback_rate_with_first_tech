CREATE VIEW glue_database_bi_bluecollar.callback_rate_with_first_tech AS
WITH
  completed_events AS (
   SELECT
     job_id
   , techs
   , date_parse(time_of_activity, '%m/%d/%Y %h:%i %p') time_of_activity
   , CAST(date_parse(time_of_activity, '%m/%d/%Y %h:%i %p') AS date) activity_date
   FROM
     job_activity
   WHERE (LOWER(activity) LIKE '%completed%')
) 
, distinct_dates AS (
   SELECT
     job_id
   , techs
   , MIN(time_of_activity) time_of_activity
   , activity_date
   FROM
     completed_events
   GROUP BY job_id, techs, activity_date
) 
, ranked AS (
   SELECT
     job_id
   , techs
   , time_of_activity
   , ROW_NUMBER() OVER (PARTITION BY job_id ORDER BY time_of_activity ASC) rn
   , COUNT(*) OVER (PARTITION BY job_id) ts_count
   FROM
     distinct_dates
) 
, first_second AS (
   SELECT
     job_id
   , MAX((CASE WHEN (rn = 1) THEN time_of_activity END)) first_timestamp
   , MAX((CASE WHEN (rn = 2) THEN time_of_activity END)) second_timestamp
   , CAST(MAX((CASE WHEN (rn = 1) THEN time_of_activity END)) AS date) first_activity_date
   , MAX((CASE WHEN (rn = 1) THEN trim(BOTH FROM split_part(techs, ',', 1)) END)) first_tech
   FROM
     ranked
   WHERE (ts_count > 1)
   GROUP BY job_id
) 
, totals AS (
   SELECT COUNT(DISTINCT job_id) total_jobs_completed
   FROM
     completed_events
) 
, total_jobs_per_day AS (
   SELECT
     activity_date
   , COUNT(DISTINCT job_id) total_jobs_completed_day
   FROM
     completed_events
   GROUP BY activity_date
) 
SELECT
  f.job_id
, f.first_timestamp
, f.second_timestamp
, f.first_tech
, t.total_jobs_completed
, d.total_jobs_completed_day
FROM
  ((first_second f
CROSS JOIN totals t)
LEFT JOIN total_jobs_per_day d ON (f.first_activity_date = d.activity_date))
ORDER BY f.job_id ASC
